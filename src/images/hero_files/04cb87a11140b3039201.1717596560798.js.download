h-1.amazonaws.com/sheba_xyz/images/car-rental-app-screen.webp"},counterData:[{title:"Service Providers",count:"15,000 +"},{title:"Order Served",count:"2,00,000 +"},{title:"5 Star Received",count:"1,00,000 +"}],faqData:[{question:"What is the Minimum Booking time ?",answer:"120mins required to Start the service"},{question:"Is it possible to choose a specific car model?",answer:"No, based on Car Availability your car will select automatically.: (i.e. Toyota Axio and/or equivalent and/or 2005 model onwards, etc.)"},{question:"Is it possible to have any special car model requirements?",answer:"You can add an addition in case you are looking for a specific model car. In that case, Sheba.xyz car rental service will make an attempt to get a specific car based on your requirements. However, the service charge may also be adjusted depending on your requirement (i.e.- Car Type, model, and service availability)."},{question:"Is the service price fixed?",answer:"Yes. However, it may be adjusted in case of your requirement based on Car Type, Model, and Service Availability etc."},{question:"What is Included in this service?",answer:"Service Charges, fuel costs, and driver allowance are all-inclusive."},{question:"What is excluded from this Inside City Service?",answerHtml:"- Half-Day Package Includes 4 Hours duty Inside the metropolitan city, a maximum of 40KM running.<br>- Full-Day Package Includes: 10 Hours duty Inside metropolitan city  and Max 80KM running<br>After that Extra Hour and Extra Bill Charge will be applicables"},{question:"What is excluded from this Outside City Service?",answerHtml:"<strong>For One Way:</strong><br><li>Bill will be calculated based on the Pick-point and Drop-point.</li><li>If you want to go to any other location from the given drop-point, extra KM will be applied.</li><li>In that case, the extra bill will be calculated from Drop-point to the new location (the location where you want to be dropped).</li><li>Per KM charge for the new location will be BDT 28.</li><strong>For Round Trip:</strong><br><li>Car will drop the customer at Drop-point, stay there for 2 hours and then a round-trip to Pick-up point.</li><li>If you want to stay more than 2 hours, waiting charge will be applied.</li><li>If you want to go to any other places, extra KM charge will be applied.</li><li>If you want to have a night-stay, a driver allowance of BDT 1000 will be charged, if you do not provide accommodation and food for the driver.</li>"},{question:"Can I choose any route to reach my destination for outside city car rental?",answer:"No, you can’t choose any route that you like. Service providers will use the route as per given in the system. However, due to any unavoidable circumstances, the route may be changed. If you need to change the route, the extra KM charge will be applied. "},{question:"What is the extra KM and the extra hour charge?",answerHtml:"<li>Sedan Car Extra Charge- BDT 300/hour</li><li>Hiace & Noah Extra Charge- BDT 400/hour</li><li>Extra KM Charge- BDT 28 per/KM</li>"}],bannerInformation:{},breadcrumb:[],breadcrumbSchema:null,faqSchema:null,reviewSchema:null,aggregateReviewSchema:null,serviceSchema:null,carRentalSecondaries:[]}},asyncData:(a=Object(r.a)(regeneratorRuntime.mark((function e(t){var s,a,i,r,n,l,u,d;return regeneratorRuntime.wrap((function(e){for(;;)switch(e.prev=e.next){case 0:return s=t.store,a=t.req,t.params,t.redirect,Object(c.b)(s,a),i={},e.next=6,o.a.get("https://api.sheba.xyz/v3/schema?type_id=221&type=category");case 6:return 200===(r=e.sent).data.code&&(i.breadcrumbSchema=r.data.breadcrumb,i.faqSchema=r.data.faq,i.reviewSchema=r.data.review,i.aggregateReviewSchema=r.data.aggregate_review,i.serviceSchema=r.data.service),n=null,e.prev=9,e.next=12,o.a.get("https://api.sheba.xyz/v3/settings/car");case 12:l=e.sent,n=l.data&&200===l.data.code?l.data.settings:null,e.next=19;break;case 16:e.prev=16,e.t0=e.catch(9),n=null;case 19:if(s.commit("carRental/updateCarRentalSettings",n),n&&n.sub_cats){e.nex