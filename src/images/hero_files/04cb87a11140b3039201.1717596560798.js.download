mponents:g,mixins:[o.a,c.a,h.a,p.a],data:function(){return{name:"",categories:[],categoryGroupNames:[{name:"high-demand",sendLocationInfo:!0}],categoryGroups:[],OfferGroups:null,singleServiceGroup:null,serviceGroups:[],ServiceGroupName:null,orderAgainServices:[],allServicesIsLoading:!0,visitedCategories:[],showTopScroll:!0,showBottomScroll:!1,homeSettings:null,homeBannerDesktop:null,components:g,selectedLocation:null,howItWorksData:{title:"Easiest way to get a service",items:[{text:"Select the Service",subText:"Pick the service you are looking for- from the website or the app."},{text:"Pick your schedule",subText:"Pick your convenient date and time to avail the service. Pick the service provider based on their rating."},{text:"Place Your Order & Relax",subText:"Review and place the order. Now just sit back and relax. We’ll assign the expert service provider’s schedule for you."}],video:{link:"https://www.youtube.com/watch?v=OMW0BfVYSOI&feature=youtu.be",description:"how sheba works",thumbWebp:"https://cdn-shebaxyz.s3.ap-south-1.amazonaws.com/sheba_xyz/images/process-thumbnail.webp",thumb:"https://cdn-shebaxyz.s3.ap-south-1.amazonaws.com/sheba_xyz/images/process-thumbnail.jpg"}},testimonialData:{sectionTitle:"SOME HAPPY FACES",title:"Real Happy Customers, Real Stories",items:[{text:"Such service platforms are available in other countries. I’ve personally used those when I was abroad. I’m very pleased that such a portal is available here in Bangladesh as well. Thank you Sheba.xyz.",person:{name:"Zabeen Yusuf Nur",designation:"IT Consultant, Australia",workplace:null},video:{link:"https://www.youtube.com/watch?v=Ey0ESUxWTL0&feature=youtu.be",description:"happy customer",thumbWebp:"https://cdn-shebaxyz.s3.ap-south-1.amazonaws.com/sheba_xyz/images/testimonial-1.webp",thumb:"https://cdn-shebaxyz.s3.ap-south-1.amazonaws.com/sheba_xyz/images/testimonial-1.jpg"}},{text:"It was my marriage and wasn’t getting schedule from any beauty parlor.\nSo, I downloaded Sheba.xyz app and found that it has all of my requirements. \nThe beautician arrived in time and was really amazing. Thank you.",person:{name:"Zeba Fariba",designation:"Management Trainee",workplace:null},video:{link:"https://www.youtube.com/watch?v=_1juTr9E46U&feature=youtu.be",description:"happy customer",thumbWebp:"https://cdn-shebaxyz.s3.ap-south-1.amazonaws.com/sheba_xyz/images/testimonial-2.webp",thumb:"https://cdn-shebaxyz.s3.ap-south-1.amazonaws.com/sheba_xyz/images/testimonial-2.jpg"}},{text:"Initially I was reluctant. I wasn’t sure how an online platform would be.\nSheba.xyz was able to complete the job just as I imagined it to be. Thanks to them, they made it possible.",person:{name:"Arif Ur Rahman",designation:"Partner",workplace:"Flyout BD"},video:{link:"https://youtu.be/kBfA4gmO6pI",description:"happy customer",thumbWebp:"https://cdn-shebaxyz.s3.ap-south-1.amazonaws.com/sheba_xyz/images/testimonial-3.webp",thumb:"https://cdn-shebaxyz.s3.ap-south-1.amazonaws.com/sheba_xyz/images/testimonial-3.jpg"}},{text:"Sheba.xyz services are very helpful for working women like me.\nThey were on time as per the schedule to provide the service, and I’m very satisfied with their quality of service.",person:{name:"Saima Ahmad",designation:"Associate Professor",workplace:"Bangladesh Open University"},video:{link:"https://www.youtube.com/watch?v=FVS6l4mJ5fo&feature=youtu.be",description:"happy customer",thumbWebp:"https://cdn-shebaxyz.s3.ap-south-1.amazonaws.com/sheba_xyz/images/testimonial-4.webp",thumb:"https://cdn-shebaxyz.s3.ap-south-1.amazonaws.com/sheba_xyz/images/testimonial-4.jpg"}}]},appDownloadSectionData:{sectionTitle:"Download Our App",title:"Any Service, Any Time, Anywhere.",text:"Give us your mobile number. You’ll get an SMS with the app download link.",imageWebp:"https://cdn-shebaxyz.s3.ap-south-1.amazonaws.com/sheba_xyz/images/app-download.webp",image:"https://cdn-shebaxyz.s3.ap-south-1.amazonaws.com/sheba_xyz/images/app-download.jpg"},counterData:[{title:"Service Provider